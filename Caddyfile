{$SITE_DOMAIN} {
    log {
        output stdout
        format json
    }
    encode zstd gzip

    @api path /api /api/*
    handle @api {
        reverse_proxy api:4000
    }

    handle {
        root * /srv
        route {
            try_files {path} /index.html
            header /index.html Cache-Control "no-cache"
            file_server
        }
    }
}

www.{$SITE_DOMAIN} {
    redir https://{$SITE_DOMAIN}{uri} permanent
}
